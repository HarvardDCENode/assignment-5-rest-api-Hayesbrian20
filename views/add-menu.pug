doctype html
html
  head
    title Add/Edit Menu Item
    link(rel="stylesheet", href="/styles.css")
  body
    h1= menuItem ? 'Edit Menu Item' : 'Add Menu Item'
    form(action=menuItem ? `/menu/${menuItem._id}?_method=PUT` : '/menu', method="POST")
      input(type="text", name="item", placeholder="Item Name", value=menuItem ? menuItem.item : '')
      input(type="text", name="description", placeholder="Description", value=menuItem ? menuItem.description : '')
      input(type="number", step="0.01", name="price", placeholder="Price", value=menuItem ? menuItem.price : '')
      button(type="submit")= menuItem ? 'Update' : 'Add'
    a(href='/menu') Back to Menu

doctype html
html
  head
    title Menu Items
    link(rel="stylesheet", href="/styles.css")
  body
    h1 Menu
    a(href='/menu/new') Add Menu Item
    ul
      each item in menu
        li
          | #{item.item} - $#{item.price.toFixed(2)} (#{item.description})
          a(href=`/menu/${item._id}/edit`) Edit
          form(action=`/menu/${item._id}?_method=DELETE`, method="POST", style="display:inline")
            button(type="submit") Delete
    a(href='/') Back Home
